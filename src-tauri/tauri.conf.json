{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STRM Scout",
  "version": "0.1.0",
  "identifier": "com.argos.strminspector",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "STRM Scout",
      "width": 1240,
      "height": 780,
      "minWidth": 900,
      "minHeight": 640,
      "resizable": true,
      "center": true
    }],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"] }
}
